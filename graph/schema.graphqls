# GraphQL vfeeg-backend
#

scalar Eeg
scalar Upload

type Link {
  id: ID!
  title: String!
  address: String!
}

input EegModel {
  tenant: String
  "Ignored: the settlement interval changes only through POST /eeg/settlementinterval with its rule."
  settlementInterval: String @deprecated(reason: "Ignored, changes nothing: use POST /eeg/settlementinterval.")
  sepaActiv: Boolean
}


type Query {
  eeg: Eeg
  links: [Link!]!
}

type Mutation {
  updateEegModel(tenant: String!, eegModel: EegModel): Eeg
  masterDataUpload(tenant: String!, sheet: String!, file: Upload!): Boolean!
}